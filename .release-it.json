{
  "$schema": "https://unpkg.com/release-it/schema/release-it.json",
  "git": {
    "commitMessage": "chore: release v${version}",
    "push": true,
    "requireBranch": "master",
    "tagName": "v${version}"
  },
  "github": {
    "release": true
  },
  "hooks": {
    "after:bump": [
      "sed -i.bak 's/SDK_VERSION = \".*\"/SDK_VERSION = \"${version}\"/' src/constants/version.ts && rm src/constants/version.ts.bak",
      "git add src/constants/version.ts",
      "yarn auto-changelog",
      "git add CHANGELOG.md"
    ],
    "before:init": ["yarn check-ts", "yarn build:clean"]
  },
  "npm": {
    "publish": true,
    "skipChecks": true,
    "timeout": 60
  }
}
